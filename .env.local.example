# Copiar para .env.local (nunca commitar o .env.local).
# As mesmas variáveis têm de ser criadas no Netlify:
# Site settings → Environment variables.

# --- Supabase (guarda os pedidos) -------------------------------------------
# Project settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project settings → API keys → service_role  (SECRETA: só no servidor)
SUPABASE_SERVICE_ROLE_KEY=

# --- Brevo (envia a notificação por email) ----------------------------------
# brevo.com → SMTP & API → API keys
BREVO_API_KEY=
# Remetente verificado na Brevo (Senders, Domains & Dedicated IPs)
BREVO_SENDER=geral@starmountainflash.pt
# Para onde vão as notificações de novos pedidos
LEAD_NOTIFY_TO=geral@starmountainflash.pt

# --- Limite de pedidos por IP -----------------------------------------------
# Texto aleatório e secreto. O IP é guardado em hash, nunca em claro.
# Gerar com: openssl rand -hex 32
LEAD_IP_SALT=

# --- Google Analytics 4 (opcional) ------------------------------------------
# Só carrega depois de o visitante aceitar cookies. Deixar vazio desliga o GA.
NEXT_PUBLIC_GA_ID=
